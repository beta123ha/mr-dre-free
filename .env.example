# LOCAL BENCHMARK - zero paid API keys required
MRDRE_LLM_BACKEND=ollama
MRDRE_LOCAL_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MRDRE_CRAWLER=direct
MRDRE_SEARCH=ddg
# Initial RTX 4050 6GB / RAM 32GB profile; validate throughput before scaling
MRDRE_EVAL_WORKERS=2
MRDRE_SUMMARY_WORKERS=2
# Original LangChain Open Deep Research server (not GPT Researcher)
ODR_URL=http://127.0.0.1:2024
ODR_GRAPH_ID=Deep Researcher
ODR_LOCAL_MODEL=qwen3:4b
ODR_MCP_URL=http://127.0.0.1:8001
ODR_RESEARCH_CONCURRENCY=2
ODR_RESEARCH_ITERATIONS=6
ODR_MAX_TOOL_CALLS=10
# ReviserAgent: same ReAct loop and max 10 search calls as upstream
REVISER_BASE_URL=http://127.0.0.1:11434/v1
REVISER_MODEL=qwen3:4b
REQUEST_TIMEOUT_SECONDS=7200
POLL_INTERVAL_SECONDS=5
BATCH_TIMEOUT_MINUTES=180
