# Set both endpoints to localhost inside Kaggle.
MRDRE_LLM_BACKEND=ollama
MRDRE_LOCAL_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
MRDRE_CRAWLER=direct
MRDRE_SEARCH=ddg
MRDRE_EVAL_WORKERS=1
MRDRE_SUMMARY_WORKERS=1
ODR_URL=http://127.0.0.1:2024
ODR_GRAPH_ID=Deep Researcher
ODR_LOCAL_MODEL=qwen3:4b-instruct
ODR_MCP_URL=http://127.0.0.1:8001
ODR_RESEARCH_CONCURRENCY=1
# FAST profile. For closer original protocol use iterations=6, calls=10 and higher max tokens.
ODR_RESEARCH_ITERATIONS=3
ODR_MAX_TOOL_CALLS=6
ODR_FINAL_MAX_TOKENS=6144
REQUEST_TIMEOUT_SECONDS=3600
POLL_INTERVAL_SECONDS=2
BATCH_TIMEOUT_MINUTES=110
